    <selectionEntry id="9470-3822-9925-43d2" name="Deathwind Drop Pod (IA)" hidden="false" collective="false" import="true" type="model">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3261-6601-5bfe-f5d0" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="8532-409c-2240-2c5f" name="Reserves" hidden="false">
          <description>Units in drop pods are always in Reserve, even in missions that do not normally allow reserves to be used</description>
        </rule>
        <rule id="b044-faa1-ea9d-ceb3" name="Drop Pod Deployment" hidden="false">
          <description>See 1st Edition Imperial Armour v2</description>
        </rule>
        <rule id="bb84-de5f-7c74-3eb0" name="Automated Weapons" hidden="false">
          <description>When the Deathwind drop pod lands it opens fire. After landing, each unit (enemy and friendly) within 12&quot; of the Deathwind and in line of sight is fired as a hail of missiles or bullets sweep the area. Roll to hit using the Deathwind&apos;s BS2 for either D3 frag missile attacks or a D3 assault cannon attacks (Heavy 3) against each target unit.
After the first turn of firing the Deathwind cannot fire again.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0e75-e899-877e-dd99" name="Drop Pod" hidden="false" targetId="a16a-f61f-0a2d-94d9" type="profile"/>
      </infoLinks>
