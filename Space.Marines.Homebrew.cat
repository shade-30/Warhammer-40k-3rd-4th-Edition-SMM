        <profile id="1e0b-10f2-fd28-db57" name="Rod of Tigurius" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Ranged Weapon">
          <characteristics>
            <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Melee</characteristic>
            <characteristic name="S" typeId="24d8-2110-08fa-d844">As User</characteristic>
            <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
            <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Melee</characteristic>
            <characteristic name="Abilities" typeId="492d-1f80-b777-26f2">Ignores armour saves. If at least one wound was inflicted take a psychic test. On a successful test the target instantly dies. The Rod of Tigurius allows a reroll on the psychic test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="2883-89f2-07a5-d27f" name="Hood of Hellfire" hidden="false">
          <description>Counts as a psychic good. Additionally increases Tigurius&apos;s Smite&apos;s range to 24&quot;.</description>
        </rule>
      </rules>
