      <rules>
        <rule id="be72-0b5f-5d6a-98ca" name="Transport Capacity" hidden="false">
          <description>A stormraven gunship can carry up to 12 models (count terminators as 2 models each), or a single dreadnaught.</description>
        </rule>
        <rule id="2b31-c6e9-afdc-5f33" name="Stormraven Gunship (Homebrew)" hidden="false">
          <description>Based on the vehicle design rules in Chapter Approved 2004. The vehicle is a Fast Skimmer with a transport capacity of 12 models or 1 dreadnought.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="e39f-14d3-9062-dd5e" name="Stormraven Gunship (Homebrew)" hidden="false" targetId="2a32-eb54-06dd-1a3b" type="profile"/>
