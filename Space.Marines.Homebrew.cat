    <selectionEntry id="9419-6303-5744-f2b2" name="Orbital Strike (IA)" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3261-6601-5bfe-f5d0" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <selectionEntryGroups>
        <selectionEntryGroup id="d064-40aa-7c75-089d" name="Strike" hidden="false" collective="false" import="true">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d75e-da63-9ffe-352e" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8c55-8b6c-10af-a1de" type="min"/>
          </constraints>
          <rules>
            <rule id="927d-2e56-f581-a7ad" name="Plotting" hidden="false">
              <description>The Orbital Strike must be keyed to a specific piece of terrain at the start of the battle. Make a note of the plotted target before forces are deployed but after deployment zones have been determined</description>
            </rule>
            <rule id="d44e-df6c-f95e-c152" name="Timing" hidden="false">
              <description>An orbital strike uses the Reserve special rule to determine when it strikes. Once the orbital strike passes the Reserve roll it fires each Space Marine shooting phases for the rest of the game. It cannot be stopped once started. The Space Marine player can opt to not roll for the onset of the orbital strike if they wish.</description>
            </rule>
            <rule id="dc29-7619-949f-8bc1" name="Placement" hidden="false">
              <description>The Ordnance Blast marker for the strike must be placed anywhere within the specified terrain piece</description>
            </rule>
            <rule id="a4ef-ff8b-b32c-5623" name="Inaccuracy" hidden="false">
              <description>An Orbital Strike scatters just like ordinary ordnance weapons, except when a miss is rolled the distance scatterd is double the number scored on the D6. If a hit is rolled, the template deviates by the distance shown on the Hit Symbol.</description>
            </rule>
            <rule id="785d-9333-5372-b764" name="Pinning" hidden="false">
              <description>All Orbital Strikes cause Pinning tests</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry id="0be5-6e22-c8de-a80e" name="Lance Strike" hidden="false" collective="false" import="true" type="upgrade">
              <profiles>
                <profile id="3b32-25fa-23c6-e7a4" name="Lance Strike" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Ranged Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="deb8-131d-bdcf-1376">Special</characteristic>
                    <characteristic name="S" typeId="24d8-2110-08fa-d844">10</characteristic>
                    <characteristic name="AP" typeId="25ce-028f-0aae-2855">1</characteristic>
                    <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Ordnance Blast</characteristic>
                    <characteristic name="Abilities" typeId="492d-1f80-b777-26f2"/>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="70.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="905a-7af7-3d5f-5052" name="Melta Torpedo" hidden="false" collective="false" import="true" type="upgrade">
              <profiles>
                <profile id="c384-3026-07d6-03e0" name="Melta Torpedo" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Ranged Weapon">
