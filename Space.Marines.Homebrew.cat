      </constraints>
      <rules>
        <rule id="eb55-dd8c-042f-b039" name="Vulkan&apos;s Sigil" hidden="false">
          <description>Counts as a holy relic. It affects all Salamanders within 12&quot; when it is revealed, instead of the normal 2D6&quot;.</description>
        </rule>
        <rule id="e597-ab89-12f5-c563" name="Salamanders Mantle" hidden="false">
          <description>Xavier is immune to suffering instant death by being hit by an attach which has a Strength value double his Toughness. He loses a single wound instead. Note that instant death can be suffered in other ways.</description>
        </rule>
      </rules>
      <infoLinks>
