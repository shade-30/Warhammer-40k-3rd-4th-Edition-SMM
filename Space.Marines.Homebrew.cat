      </constraints>
      <rules>
        <rule id="bf7e-96d6-5479-cf9c" name="Stubborn" hidden="false">
          <description>Once per game, ignore the first failed Fall Back test made by a unit in the army. This also applies to things that would normally cause a unit to fall back automatically without a test. </description>
        </rule>
        <rule id="0df3-4740-e28b-e806" name="Invulnerable" hidden="false">
          <description>Cortez may always take a 3+ invulnerable save</description>
        </rule>
      </rules>
