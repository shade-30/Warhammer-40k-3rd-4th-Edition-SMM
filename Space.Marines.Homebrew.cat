    <selectionEntry id="fde5-3ce5-0c7a-820c" name="Hyperious Air Defence Battery (IA)" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3261-6601-5bfe-f5d0" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="21e9-0efc-b045-a446" name="Battery" hidden="false">
          <description>The platforms do not need to be deployed together, although each Hyperios platform must be less than 36&quot; from the command platform.</description>
        </rule>
        <rule id="82d8-3330-5084-1855" name="Firing Mode" hidden="false">
          <description>The battery is always set to Air Defense mode. When an incoming aircraft is detected the control console selects the nearest platforms and relays the targetting information. The Hyperios then activates, spins, tracks, and fires.</description>
        </rule>
        <rule id="a737-6d17-43a4-9439" name="Victory Points" hidden="false">
          <description>The Air Defense Battery cannot claim to occupy table quarters or objectives.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry id="64ec-afc8-48cc-9f2c" name="Command Platform" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e9cb-6215-e57e-9fb5" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="21da-2a32-b853-9f02" type="min"/>
          </constraints>
          <infoLinks>
            <infoLink id="eb6f-0016-9ea5-0a59" name="Weapon Plaform" hidden="false" targetId="a6bb-7a68-e3e4-d388" type="profile">
              <modifiers>
                <modifier type="set" field="b109-f88e-dcc7-8a24" value="2"/>
              </modifiers>
            </infoLink>
            <infoLink id="d1ee-03ae-b6fc-fdae" name="Immobile" hidden="false" targetId="de3d-c21c-3d4f-5259" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="74f8-241c-210b-ed40" name="Hyperios Platform" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="4.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a268-ea8e-5594-0b78" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="81e3-30ac-e4fc-6ffc" type="min"/>
          </constraints>
          <rules>
            <rule id="debe-94ce-59cc-73ee" name="Anti Air" hidden="false">
              <description>May fire at aircraft using normal BS</description>
            </rule>
            <rule id="e455-32f8-4894-55bf" name="Targeting" hidden="false">
              <description>A Hyperious platform will fire a single missile in its own Shooting phase at any enemy aircraft whose flight path takes it within 36&quot; of a platform. If the aircraft&apos;s flight path takes it within 36&quot; of multiple platforms then each plaform will fire a single missile.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="90dc-dabb-5d4d-743c" name="Weapon Plaform" hidden="false" targetId="a6bb-7a68-e3e4-d388" type="profile">
              <modifiers>
                <modifier type="set" field="b109-f88e-dcc7-8a24" value="2"/>
              </modifiers>
            </infoLink>
            <infoLink id="56b9-ca13-b250-113f" name="Immobile" hidden="false" targetId="de3d-c21c-3d4f-5259" type="rule"/>
            <infoLink id="d9c9-e427-7cdc-637a" name="Hyperios Ant-Aircraft Missiles" hidden="false" targetId="beb4-876e-921a-2c8f" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="35.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0.0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="fb33-3e36-b9a7-679d" name="Stormraven Gunship (VDR)" hidden="false" collective="false" import="true" type="unit">
      <comment>Based on vehicle design rules and 7th edition stats

Skimmer-Normal
Points for Armour:
Front 12 = 10
Side 11 = 30
Rear 10 = 10
Armour &lt; 46 = 10
Normal Speed = 10
Skimmer = 20

Transport = 12</comment>
