      </profiles>
      <rules>
        <rule id="8714-fef0-1bcb-216d" name="Never Falls Back" hidden="false">
          <description>Calgar and the unit he has joined never falls back. They automatically pass any Fall Back tests and is not effected by abilities that cause troops to automatically fall back.</description>
