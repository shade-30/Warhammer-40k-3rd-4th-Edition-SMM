          </constraints>
          <infoLinks>
            <infoLink id="88b4-2519-658c-8d72" name="Armour Plates" hidden="false" targetId="810d-68ab-fd52-6cf1" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="9b1d-140c-8cce-e2cf" name="Grabbin&apos; Klaw" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2fbd-5fa7-d1f5-8c4e" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4383-b412-fc4d-168a" type="max"/>
          </constraints>
          <rules>
            <rule id="d6c5-148b-4ec0-c322" name="Grabbin&apos; Klaw" hidden="false">
              <description>At the beginning of the enemy Movement phase, nominate an enemy vehicle within 2&quot; of the grabbin&apos; klaw. On a roll of 4+ that vehicle may not move this turn.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="5878-83d4-3a16-11f1" name="Boarding Plank" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="510f-9c50-77aa-f490" type="instanceOf"/>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8f6c-e0de-fded-2875" type="instanceOf"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="23f7-c076-d622-a2f4" type="max"/>
          </constraints>
          <rules>
            <rule id="8a77-acf4-abc9-f8f5" name="Boarding Plank" hidden="false">
              <description>A boarding plank allows a single embarked Ork to make its close combat attacks against an enemy vehicle within 2&quot; exactly as if the Ork were disembarked and charging, provided neither vehicle has moved more than 12&quot;.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="2309-5dc2-c674-cd3d" name="Grot Riggers" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="95dc-839d-8f54-f5d9" type="max"/>
          </constraints>
          <rules>
            <rule id="2f97-6fb2-4f85-64f4" name="Grot Riggers" hidden="false">
              <description>An Immobilised Ork vehicle with Grot riggers may roll a dice during the ork shooting phase - on a 4+ the Immobilised result is negated. The vehicle is able to start moving next turn.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="cfb7-2ae5-d9ee-32c6" name="Red Paint Job" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8f6c-e0de-fded-2875" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6896-2e95-0168-902a" type="max"/>
          </constraints>
          <rules>
            <rule id="f483-f0b8-373b-ed5d" name="Red Paint Job" hidden="false">
              <description>Ork vehicles with red paint jobs add +1 to their move in the Movement phase but do not incur penalties for this extra inch. For example, a vehicle could move 13&quot; and still count as moving 12&quot;.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="9d90-6c2e-f6c0-b8a5" name="Reinforced Ram" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="510f-9c50-77aa-f490" type="instanceOf"/>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8f6c-e0de-fded-2875" type="instanceOf"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier type="set" field="ca35-f431-d666-78e5" value="0.0">
              <conditions>
                <condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="92f7-25d2-bead-8acf" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ca35-f431-d666-78e5" type="max"/>
          </constraints>
          <rules>
            <rule id="9bef-9038-cb77-ddbc" name="Reinforced Ram" hidden="false">
              <description>A vehicle with a reinforced ram can Tank Shock, and treats its front armour as two higher than normal when resolving Death or Glory attacks (to a maximum of 14). Furthermore the vehicle may re-roll Dangerous Terrain tests.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d18d-c3c9-8ddc-6d2c" name="Searchlight" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a201-34bd-fd32-9421" type="max"/>
          </constraints>
          <rules>
            <rule id="da1f-a404-cc21-3cf9" name="Searchlight" hidden="false">
              <description>Searchlights are only used in missions where the rules for night fighting are being used. They allow one enemy unit spotted by the vehicle or Dreadnought to be fired at by all other Ork units that are in range and have a line of fire. However, the vehicle or Dreadnought using the Searchlight in this manner is considered visible to all enemy units who have line of sight on the next turn.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="1.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b867-f671-19fa-ca39" name="Spikes &apos;n Blades" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8f6c-e0de-fded-2875" type="instanceOf"/>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="54fe-3f68-d142-362b" type="instanceOf"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="36b1-5531-b287-d894" type="max"/>
          </constraints>
          <rules>
            <rule id="2352-a577-ca88-f7ba" name="Spikes &apos;n Blades" hidden="false">
              <description>Enemy infantry which try to attack a vehicle that has spikes &apos;n blades in close combat and miss suffer a S3 hit. </description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="94b7-9970-6ce9-57dd" name="Stikkabomb Chucka" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="510f-9c50-77aa-f490" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4c8b-2703-73a7-b74a" type="max"/>
          </constraints>
          <rules>
            <rule id="0cfd-4b78-658e-d07d" name="Stikkabomb Chucka" hidden="false">
              <description>Any walker, or unit disembarking from a vehicle, with a stikkbomb chukka is treated as having stikkbombs if they charge into combat.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="6066-7be1-f552-a410" name="Turbo Boosta" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8f6c-e0de-fded-2875" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4982-402d-b4d7-7ff0" type="max"/>
          </constraints>
          <rules>
            <rule id="4e51-00f3-0af5-dcfd" name="Turbo Boosta" hidden="false">
              <description>A vehicle with turbo boostas can trigger them in any of its movement phases. The trubo boostas add D6&quot; to its movement, but for shooting and disembarking troops the vehicle counts as moving at the speed it went before the turbo boosters were added. The extra D&quot; movement must be used to move in a straight line and if a 4+ is rolled the vehicle and any passengers onboard may not shoot or disembark that turn as they are too busy hanging on for grim death.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1968-0665-94dc-5fe7" name="Wrecker Ball" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="510f-9c50-77aa-f490" type="instanceOf"/>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8f6c-e0de-fded-2875" type="instanceOf"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e92f-ed99-d674-c4f7" type="max"/>
          </constraints>
          <rules>
            <rule id="24f4-a556-d019-7a16" name="Wrecker Ball" hidden="false">
              <description>A vehicle with a wreckin&apos; ball causes a Strength 9 hit upon one unengaged enemy unit within 2&quot; of the wreckin&apos; ball at the beginning of the Assault phase on a roll of 4+. The vehicle may not use its wreckin&apos; ball if it has moved more than 12&quot; that turn.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1c6c-7e99-52a9-bd90" name="&apos;ard Case" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2fbd-5fa7-d1f5-8c4e" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1864-343b-7587-b14e" type="max"/>
          </constraints>
          <rules>
            <rule id="b28b-e1b3-3e74-19af" name="&apos;ard Case" hidden="false">
              <description>A vehicle with an &apos;ard case no longer counts as Open-Topped. Note that this affects its Access Points and Fire Points as detailed in the appropriate entry.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="15.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="92f7-25d2-bead-8acf" name="Deff Rolla" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2fbd-5fa7-d1f5-8c4e" type="notInstanceOf"/>
              </conditions>
            </modifier>
            <modifier type="set" field="6458-c637-3b09-bcfe" value="0.0">
              <conditions>
                <condition field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="9d90-6c2e-f6c0-b8a5" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6458-c637-3b09-bcfe" type="max"/>
          </constraints>
          <rules>
            <rule id="9c4b-b3a3-5b95-5a6e" name="Deff Rolla" hidden="false">
              <description>A Battlewagon with a deff rolla may re-roll Dangerous Terrain tests. Any Tank Shock made by a Battlewagon with a deff rolla causes D6 Strength 10 hits on the victim unit. If the unit elects to make a Death or Glory attack, it takes a further D6 Strength 10 hits in addition to the usual effects.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="20.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
