            <selectionEntry id="55d4-be27-b317-43f4" name="Warlord Ghazghkull Mag Uruk Thraka" hidden="true" collective="false" import="true" type="model">
              <rules>
                <rule id="8fd4-cd6d-340a-df47" name="Powr of the WAAAGH!" hidden="false">
                  <description>Once, during a battle, Ghazghkull can unleash the power of the waaagh!. This can be summoned at any time including during an opponent&apos;s turn. For the remainder of that player&apos;s turn and all of the following player&apos;s turn Ghazghkull gains a 2+ Invulnerable save. In addition, for the duration of the Waaagh! all Orks pass their Leadership tests and Morale checks automattically and recover from pinning immediately. Orks fighting in close combat double their Initiative just as if they had charged and passed a mob size check this turn. </description>
                </rule>
                <rule id="68c7-4998-d949-4a6d" name="Goff Army" hidden="false">
                  <description>Ghazghkull is a member of the Goff clan and his army is shaped by his prejudices. An army including Ghazghkull must have at least one mob of Skarboyz but may not include more than one unit of each of the following: Kommandos, Burna Boyz, Warbuggies, Warbikes, Big Gunz, Lootas and Looted Vehicles.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="e792-e124-95d1-c33a" name="Warlord Ghazghkull Mad Uruk Thraka" hidden="false" targetId="5f06-0630-177e-74ab" type="profile"/>
                <infoLink id="63e0-1cfa-ae6d-da96" name="Independent Character" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule"/>
                <infoLink id="13c9-8be6-b516-fb00" name="Ork Mob Rule!" hidden="false" targetId="1586-dbe5-3b2e-7590" type="rule"/>
              </infoLinks>
              <categoryLinks>
                <categoryLink id="d821-e392-e7c5-4941" name="Independent Character" hidden="false" targetId="3c96-248b-affd-e504" primary="false"/>
                <categoryLink id="035a-6213-810b-28a7" name="Infantry" hidden="false" targetId="6953-6bba-0bb9-d49d" primary="false"/>
                <categoryLink id="b830-6239-bec3-ce44" name="Warboss" hidden="false" targetId="f86e-9066-de2e-bf53" primary="false"/>
              </categoryLinks>
              <selectionEntries>
                <selectionEntry id="877d-b70b-5a8d-b33e" name="Iron Gob" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="79c7-4de5-f588-5555" type="max"/>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b979-333e-9aa2-9bad" type="min"/>
                  </constraints>
                  <rules>
                    <rule id="d41a-694c-f2a5-a1d6" name="Iron Gob" hidden="false">
                      <description>A mob led by a Warboss or Nob with an Iron Gob add +1 to their Leadership value.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0.0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="cfb1-3145-cb23-7c47" name="Bosspole" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2c17-2d95-df89-5c64" type="max"/>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4af5-d1b5-8e14-fd5d" type="min"/>
                  </constraints>
                  <rules>
                    <rule id="2363-134d-938e-7513" name="Bosspole" hidden="false">
                      <description>An Ork mob trying to mob up with a mob carrying a bosspole may re-roll their Leadership test if they fail on the first try.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0.0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="15ef-ecf7-de44-acbd" name="Mega Armor" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="48d6-e00b-8322-3fa2" type="max"/>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d68a-181c-04eb-13cf" type="min"/>
                  </constraints>
                  <rules>
                    <rule id="7a30-2b11-b801-cea2" name="Mega Armor" hidden="false">
                      <description>An Ork in Mega Armor gains a 2+ armor save and is armed with a shoota and power claw for free. However, an Ork in mega armor always moves as if in difficult terrain.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0.0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="3b82-2bae-cada-fe7a" name="Mega Boosta" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dcd0-14d7-aead-f93b" type="max"/>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b7d4-a13f-7b25-9dc0" type="min"/>
                  </constraints>
                  <rules>
                    <rule id="083d-c909-cd48-4a00" name="Mega Boosta" hidden="false">
                      <description>An Ork with Mega Boostas rerolls the dice to determine the distance they move when they are wearing Mega Armor. If a unit of Orks in Mega Armor includes some with Mega Boosters and some without, only the ones with Mega Boosters will gain the benefit of the re-roll while the others move the original distance rolled.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0.0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="e204-2bd1-4ba3-f21a" name="Stickbomb Chucka" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c596-258c-ca2c-aa85" type="min"/>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b966-a659-45aa-92ee" type="max"/>
                  </constraints>
                  <rules>
                    <rule id="572a-cc79-02e8-9cc7" name="Stikkbomb Chucka" hidden="false">
                      <description>A stikkbomb chukka allows a Mega Armoured Ork use frag stikkbombz so they can benefit from the frag grenades rule, but in order to do so they must attack with their base strength instead of using the Power Claw.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0.0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="67d6-d2e2-d7e2-79ca" name="Adamantium Skull" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="93e8-fa41-7684-3884" type="max"/>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b2a7-6c20-d023-f126" type="min"/>
                  </constraints>
                  <rules>
                    <rule id="4259-b453-d02a-f018" name="Adamantium Skull" hidden="false">
                      <description>The adamantium skull plate adds +1 Toughness. When Ghazghkull charges into combat he gets an extra free head butt attack against one model in base-to-base contact with him. The head butt is resolved as an attack made with an Initiative of 4, roll to hit as normal for a close combat blow and if a hit is scored roll to wound with Ghazghkull&apos;s Strength of 5. A model that suffers a wound from the head butt is stunned for the rest of the turn and may not attack in close combat.</description>
                    </rule>
                  </rules>
                  <costs>
                    <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0.0"/>
                  </costs>
                </selectionEntry>
                <selectionEntry id="3199-ba7f-9aa4-27de" name="Kustom Shoota" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0751-4802-b19c-5583" type="max"/>
                    <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8f2e-34f2-49fd-33ad" type="min"/>
                  </constraints>
                  <profiles>
                    <profile id="ec95-9c81-370f-b5a2" name="Kustom Shoota" hidden="false" typeId="b399-8a1b-bf0b-c5b7" typeName="Ranged Weapon">
                      <characteristics>
                        <characteristic name="Range" typeId="deb8-131d-bdcf-1376">24&quot;</characteristic>
                        <characteristic name="Type" typeId="d3f6-19e8-ac9e-ae13">Assault 2</characteristic>
                        <characteristic name="AP" typeId="25ce-028f-0aae-2855">6</characteristic>
                        <characteristic name="S" typeId="24d8-2110-08fa-d844">5</characteristic>
                        <characteristic name="Abilities" typeId="492d-1f80-b777-26f2"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0.0"/>
                  </costs>
                </selectionEntry>
              </selectionEntries>
              <costs>
                <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="225.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="fc15-8e32-805f-64c5" name="Warlord Nazdreg Ug Urdgrub" hidden="true" collective="false" import="true" type="model">
              <rules>
                <rule id="28a5-6d47-d38e-b1fc" name="Kunnin&apos; Plans" hidden="false">
                  <description>One Elites or Troops mob in Nazdreg&apos;s army can use either the Infiltrators or Deep Strike rules. If the option to Deep Strike is chosen, this may be used regardless of whether the scenario normally uses these rules. The mob chosen must be on foot and may not number more than twenty models.</description>
                </rule>
                <rule id="ac81-64a2-e5a5-0536" name="Bad Moon Army" hidden="false">
                  <description>Nazdreg is a member of the Bad Moon clan and his well equipped army will reflect this. If Nazdreg leads an army it may include up to one extra Heavy Support unit over and above the number shown on the force organisation chart. It may not include more than one unit of each of the following: Skarboyz, Stormboyz, Kommandos, Slugga Boyz, Stikk Bommas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="9ebb-1f2e-bd4f-3bd7" name="Warlord Nazdreg Ug Urdgrub" hidden="false" targetId="7b32-495d-dcec-aa93" type="profile"/>
