    <selectionEntry id="88ae-7399-fb1f-2985" name="Da Boss" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7c70-140f-463b-dcad" type="min"/>
