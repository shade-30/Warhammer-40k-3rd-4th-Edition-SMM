        <selectionEntry id="42e4-b281-7b23-4d8a" name="Bionik Arm" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fe76-df1d-ee1d-f2bf" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b5d7-1c57-cafd-fa2a" type="min"/>
          </constraints>
          <rules>
            <rule id="db98-676e-d890-ba86" name="Bionik Arm" hidden="false">
              <description>An Ork with a Bionik Arm causes one automatic S4 hit in close combat at Initiative 6, but only if in base-to-base contact with the target. It also counts as an additional close combat weapon.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4059-0060-be90-2259" name="Dok&apos;s Tools" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d718-d43e-d2d0-9b04" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f320-7cd0-6b78-bc4e" type="min"/>
          </constraints>
          <rules>
            <rule id="4d06-c181-ca6c-6b03" name="Dok&apos;s Tools" hidden="false">
              <description>Once per turn at the end of the enemy&apos;s shooting phase a Mad Dok with Dok&apos;s Tools may attempt to &quot;heal&quot; a wounded or killed model. Roll a D6. On a 1 the Ork suffers 1 wound and if reduced to zero wounds is removed as a casualty. On a 2-5 there is no effect. On a 6 the Ork regains 1 wound up to the maximum it started the game with.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="160.0"/>
      </costs>
