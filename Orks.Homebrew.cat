    <selectionEntry id="f5bd-2580-54f5-182d" name="Mad Dok Grotsnik" hidden="true" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1890-56c1-f84e-5e97" type="max"/>
      </constraints>
      <rules>
        <rule id="1d25-b9ea-ba78-27e8" name="Mad!" hidden="false">
          <description>Nutso, two slices short of a loaf, not playing with a full deck of Grot teeth - you get the picture! Because of this Grotsnik is completely immune to the effects of moral and pinning. During the Ork turn Grotsnik will always move straight towards the nearest enemy and assault if he is within range.</description>
        </rule>
        <rule id="38d1-6027-9036-299b" name="Bad Influence" hidden="false">
          <description>If Grotsnik is part of a mob his crazed enthusiasm for mayhem infects the Boyz as well. Not only do they become immune to the effects of moral and pinning but they also move straight towards the nearest enemy unit and assault if it they can - they follow their Mad Dock in his headlong charge to glory!</description>
        </rule>
        <rule id="b3b8-8f17-663c-d3f2" name="More Machine than Ork" hidden="false">
          <description>The extensive rebuilding Mad Dock Grotsnik has undertaken increases his Toughness characteristic by 1.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="b670-545a-1ce1-f1b8" name="Mad Dok Grotsnik" hidden="false" targetId="c017-ef4b-d0bf-9f22" type="profile"/>
        <infoLink id="2c36-c3f9-d3f1-a3ab" name="Power Claw" hidden="false" targetId="ff9c-5b94-680f-36d5" type="profile"/>
        <infoLink id="0e30-0d17-c8c9-a079" name="Slugga" hidden="false" targetId="1aaa-4805-c346-107e" type="profile"/>
        <infoLink id="0ed4-399b-cfa0-9add" name="Independent Character" hidden="false" targetId="4a60-7f7e-c37f-a4d6" type="rule"/>
