        <selectionEntry id="b3dd-d230-371f-07f9" name="Armour Plates" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="1f27-1cf5-2237-0745" type="instanceOf"/>
