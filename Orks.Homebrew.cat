          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="afef-f28b-52fe-c51e" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1372-2a70-6b77-cf0d" type="min"/>
          </constraints>
          <rules>
            <rule id="da76-a161-6014-7a3a" name="Bionik Bonce" hidden="false">
              <description>An Ork with a bionik bonce adds +1 to its armor saving throw.</description>
            </rule>
