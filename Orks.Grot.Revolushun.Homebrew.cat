    <selectionEntry id="3016-46f0-fca7-c3fa" name="Battle Fortress" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3261-6601-5bfe-f5d0" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="2d28-78e1-599a-5525" name="Lumbering" hidden="false">
          <description>Can move up to 6&quot; per turn and it must always move straight ahead. It can pivot up to 90 degrees at the end of the move.</description>
        </rule>
        <rule id="badf-ad50-3739-598b" name="Difficult Terrain" hidden="false">
          <description>The vehicle ignores low walls, hedges, bushes and rubble. Going through other difficult terrain they test as normal. However, if they roll a 1 they are not immobilised, but instead lose D3&quot; of movement.</description>
        </rule>
        <rule id="3bb3-b057-b92f-75d5" name="Targeting" hidden="false">
          <description>Instead of picking one target, pick a target for each of its weapons</description>
        </rule>
        <rule id="0a43-c0ab-e921-fdb8" name="Tank Shock" hidden="false">
          <description>Enemy infantry test at -1 to their Leadership if they are Tank Shocked by a Battle Fortress</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6def-003d-0f1e-d224" name="Battle Fortress" hidden="false" targetId="bcdb-0b48-6a86-306a" type="profile"/>
        <infoLink id="040b-d3ab-97b7-1738" name="Battle Fortress" hidden="false" targetId="9388-8c78-ce61-689c" type="profile"/>
      </infoLinks>
      <categoryLinks>
        <categoryLink id="9e2b-1c03-2840-6a52" name="Super-Heavy Tank" hidden="false" targetId="2f2a-20bd-2241-d56a" primary="false"/>
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="d73d-6bfc-4ee3-115f" name="Bolt-on Big Shootas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="5.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a23b-1910-6520-30ba" type="max"/>
          </constraints>
          <rules>
            <rule id="babd-6e8b-4715-8310" name="Bolt-on Big Shootas" hidden="false">
              <description>These weapons must be fired by the Ork mob onboard.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="23ad-f4f5-2c09-911f" name="Big Shoota" hidden="false" targetId="b467-e518-11c9-c23a" type="profile">
              <modifiers>
