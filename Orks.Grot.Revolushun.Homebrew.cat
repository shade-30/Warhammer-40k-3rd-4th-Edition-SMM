        <selectionEntry id="74fd-7665-3c88-4e22" name="Searchlight" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9633-5b1a-785a-f902" type="max"/>
          </constraints>
          <rules>
            <rule id="bf7f-d193-728f-b706" name="Searchlight" hidden="false">
              <description>Searchlights are only used in missions where the rules for night fighting are being used. They allow one enemy unit spotted by the vehicle or Dreadnought to be fired at by all other Ork units that are in range and have a line of fire. However, the vehicle or Dreadnought using the Searchlight in this manner is considered visible to all enemy units who have line of sight on the next turn.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="1.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="cc73-635e-fa37-03ea" name="Spikes &apos;n Blades" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8f6c-e0de-fded-2875" type="instanceOf"/>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2e83-2374-4d98-f84c" type="instanceOf"/>
                    <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="510f-9c50-77aa-f490" type="instanceOf"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="39e0-f92f-5a09-2574" type="max"/>
          </constraints>
          <rules>
            <rule id="15e4-f15c-d0d3-26cf" name="Spikes &apos;n Blades" hidden="false">
              <description>Enemy infantry which try to attack a vehicle that has spikes &apos;n blades in close combat and miss suffer a S3 hit.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="2705-534c-681a-33d7" name="Stikkabomb Chucka" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="510f-9c50-77aa-f490" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4df1-0016-449d-3c6e" type="max"/>
          </constraints>
          <rules>
            <rule id="01fa-8fab-b67e-fed6" name="Stikkabomb Chucka" hidden="false">
              <description>Any walker, or unit disembarking from a vehicle, with a stikkbomb chukka is treated as having stikkbombs if they charge into combat.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="6b2d-42d3-19a5-5812" name="Turbo Boosta" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="8f6c-e0de-fded-2875" type="instanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="974c-6d24-1533-b523" type="max"/>
          </constraints>
          <rules>
            <rule id="fe30-934b-025e-4d89" name="Turbo Boosta" hidden="false">
              <description>A vehicle with turbo boostas can trigger them in any of its movement phases. The trubo boostas add D6&quot; to its movement, but for shooting and disembarking troops the vehicle counts as moving at the speed it went before the turbo boosters were added. The extra D&quot; movement must be used to move in a straight line and if a 4+ is rolled the vehicle and any passengers onboard may not shoot or disembark that turn as they are too busy hanging on for grim death.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="5.0"/>
          </costs>
        </selectionEntry>
