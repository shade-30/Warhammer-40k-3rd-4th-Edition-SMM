          <modifiers>
            <modifier type="set" field="32b5-441e-59fb-3365" value="4.0">
              <conditions>
                <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="2fbd-5fa7-d1f5-8c4e" type="instanceOf"/>
              </conditions>
