    <selectionEntry id="1641-8bab-be04-bfc1" name="Grot Fighta Mob" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="be7e-89ac-c588-1a10" name="Full Speeeeed Ahead!" hidden="false">
          <description>Grot Fighta&apos;s moves exactly 2D6&quot; in a straight line (pivoting up to 45 degrees in either direction before and after moving) instead of moving normally and may fire all weapons. They may also move up to an additional 2D6&quot; in a straight line instead of firing their weapons in the Shooting Phase. If a double 1 is rolled for movement on either set of dice, one Grot Fighta suffers an automatic Penetrating hit. When rolling for movement, roll once for the entire squadron.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="7e19-ca0a-eefc-097d" name="Scout" hidden="false" targetId="1dda-f7ff-219c-fbd2" type="rule"/>
        <infoLink id="9cc0-5ca0-d7a7-86eb" name="Easy Come, Easy Go" hidden="false" targetId="6590-e8ef-799a-dbc1" type="rule"/>
        <infoLink id="1f37-50f3-84f0-dcb6" name="Rolling Scrap-Pile" hidden="false" targetId="3d1e-6653-38cd-f74e" type="rule"/>
      </infoLinks>
      <categoryLinks>
