          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="ancestor" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="667a-ab3b-3daf-4532" type="notInstanceOf"/>
              </conditions>
            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3fe8-21d2-28f9-b313" type="max"/>
          </constraints>
          <rules>
            <rule id="e23c-7c06-8afb-1a0b" name="Mega Boosta" hidden="false">
              <description>An Ork with Mega Boostas rerolls the dice to determine the distance they move when they are wearing Mega Armor. If a unit of Orks in Mega Armor includes some with Mega Boosters and some without, only the ones with Mega Boosters will gain the benefit of the re-roll while the others move the original distance rolled.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="17a7-11bc-c0a2-4743" name="Stikkbomb Chucka" hidden="false" collective="false" import="true" type="upgrade">
