            <constraint field="selections" scope="parent" value="2.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="32b5-441e-59fb-3365" type="max"/>
          </constraints>
          <rules>
            <rule id="d34d-2baf-8583-e669" name="Grot Sponson" hidden="false">
              <description>Instead of being treated as a standard vehicle mounted weapon, the Grot Sponson uses the same rules for firing as transported models using Firing Points and is not counted as a weapon for the vehicle itself when taking damage. However, because of their precarious nature, every time a vehicle with Grot Sponsons suffers a Glancing or Penetrating hit, roll a D6 for each sponson, on a 4+ the Grot is either splattered across the hull or the whole rig simply falls off!</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="a8e7-e225-b899-776e" name="Big Shoota" hidden="false" targetId="b467-e518-11c9-c23a" type="profile">
              <modifiers>
                <modifier type="set" field="492d-1f80-b777-26f2" value="Grot Gunner"/>
              </modifiers>
            </infoLink>
            <infoLink id="8132-f7da-7a54-057e" name="Grot Gunner" hidden="false" targetId="6a30-1d46-0574-2cdd" type="rule"/>
          </infoLinks>
