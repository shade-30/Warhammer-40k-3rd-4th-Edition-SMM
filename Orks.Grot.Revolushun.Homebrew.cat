            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="0f4d-1706-642c-9baa" name="Krusher (IA)" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="87a2-d770-e7b2-937e" type="max"/>
          </constraints>
          <rules>
            <rule id="abb0-73e3-538e-bf7c" name="Krusher (IA)" hidden="false">
              <description>If the Battlewagon makes a Tank Shock attack on an enemy unit and the enemy don&apos;t fall back, then roll a D6 for each model forced to move out of the way of the vehicle. On a 4+ they are caught and crushed, and suffer a wound with normal armour saves allowed.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="4ed5-2f92-9abc-2870" value="10.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
